{
    "_comment": "Configuration template for SIFT FTIR Reply Bot",

    "portal_url": "https://sift.bizapps.suzuki/sift/",
    "username": "",
    "password": "",

    "connect_to_existing_browser": false,
    "remote_debugging_port": 9222,

    "excel_path": "FTIR_Replies.xlsx",
    "log_file": "bot.log",

    "wait_timeout_seconds": 15,
    "paste_retry_count": 3,
    "headless": false,

    "dry_run": true,
    "delay_between_rows_seconds": 2,
    "verbose_logging": false,

    "_dry_run_comment": "Set dry_run to true for your first run. The bot will paste and verify replies but will NOT click Save. Set to false only after reviewing the dry-run log.",
    "_verbose_logging_comment": "When true, paste-verification failures log the full expected/actual text to the log file. Keep false for production to avoid storing sensitive reply content in the log.",

    "_selectors_comment": "SIFT Portal element selectors (with automatic fallback to SIFT HTML defaults)",
    "selectors": {
        "username_field":           "#username, input[name='username']",
        "password_field":           "#password, input[name='password']",
        "login_button":             "#cal-login-button, input[type='submit']",
        "post_login_element":       "frame, a, body",

        "quick_search_link":        "//div[@id='group2content']//table[@class='NoBorderTable']//tr/td[2][contains(., 'QUICK SEARCH')]",
        "quick_search_box":         "#txtSel0, //input[@id='txtSel0'], input[type='text']",
        "search_submit_button":     "#searchbtn, //input[@id='searchbtn'], //input[@value='Search']",

        "results_container":        "table, div.results, body",
        "result_rows":              "table tr, div.result-row",
        "result_ftir_text":         "td:nth-child(1), a",

        "reply_individually_button":"//tr[contains(., 'Reply individually')]//input[@type='radio'] | //input[@type='radio'][following-sibling::*[contains(.,'Reply individually')]] | //label[contains(text(),'Reply individually')]//input[@type='radio']",
        "reply_textarea":           "//tr[contains(., 'Reply individually')]//textarea | //td[contains(., 'Reply individually')]/following-sibling::td//textarea | //div[@id='swFeedbackBlock']//tr[last()]//textarea",
        "save_button":              "//div[@id='swFeedbackBlock']//input[@value='Complete'] | //input[@value='Complete'] | //button[contains(text(),'Complete')] | //input[@value='Save']",

        "save_confirmation":        "",
        "save_error_banner":        "",
        "logout_button":            ""
    }
}
