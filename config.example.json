{
    "_comment": "Configuration template for SIFT FTIR Reply Bot",

    "portal_url": "https://sift.bizapps.suzuki/sift/",
    "username": "",
    "password": "",

    "connect_to_existing_browser": false,
    "remote_debugging_port": 9222,

    "excel_path": "FTIR_Replies.xlsx",
    "log_file": "bot.log",

    "wait_timeout_seconds": 15,
    "paste_retry_count": 3,
    "headless": false,

    "dry_run": true,
    "delay_between_rows_seconds": 2,
    "verbose_logging": false,

    "_dry_run_comment": "Set dry_run to true for your first run. The bot will paste and verify replies but will NOT click Save. Set to false only after reviewing the dry-run log.",
    "_verbose_logging_comment": "When true, paste-verification failures log the full expected/actual text to the log file. Keep false for production to avoid storing sensitive reply content in the log.",

    "_selectors_comment": "SIFT Portal element selectors (with automatic fallback to SIFT HTML defaults)",
    "selectors": {
        "username_field":           "input[name='username'], input[type='text']",
        "password_field":           "input[name='password'], input[type='password']",
        "login_button":             "input[type='submit'], button[type='submit']",
        "post_login_element":       "a[href*='QuickSearch'], a[href*='quick'], body",

        "quick_search_link":        "//a[contains(translate(text(), 'abcdefghijklmnopqrstuvwxyz', 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'), 'QUICK SEARCH')]",
        "quick_search_box":         "//tr[td[contains(.,'FTIR No')]]//input | //td[contains(text(),'FTIR No')]/following-sibling::td//input | input[type='text']",
        "search_submit_button":     "//input[@type='submit' and @value='Search'] | //input[@value='Search'] | //button[contains(text(),'Search')]",

        "results_container":        "table, div.results, body",
        "result_rows":              "table tr, div.result-row",
        "result_ftir_text":         "td:nth-child(1), a",

        "record_header_ftir":       "body",
        "reply_individually_button":"//input[@type='radio'][following-sibling::text()[contains(.,'Reply individually')]] | //tr[td[contains(.,'Reply individually')]]//input[@type='radio'] | //label[contains(text(),'Reply individually')]//input[@type='radio']",
        "reply_textarea":           "//textarea | //tr[td[contains(.,'Reply individually')]]/following-sibling::tr//textarea | //td[contains(.,'Reply individually')]/following-sibling::td//textarea",
        "save_button":              "//input[@value='Complete'] | //button[contains(text(),'Complete')] | //input[contains(@value,'Complete')] | //input[@value='Save']",

        "save_confirmation":        "",
        "save_error_banner":        "",
        "logout_button":            ""
    }
}
